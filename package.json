{
  "name": "@harsh-2002/olx-mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "olx-mcp": "bin/olx-mcp-wrapper.js"
  },
  "files": [
    "bin/**/*",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "package.json",
    "README.md",
    "LICENSE",
    "examples/*",
    "CONTRIBUTING.md",
    "docs/**/*",
    "tests/README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:integration": "npm run build && node integration-test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit --incremental false",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'coverage']) rmSync(path, { recursive: true, force: true });\"",
    "ci": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run ci",
    "test:docker": "node scripts/test-docker.mjs",
    "test:live:mcp": "npm run build && node scripts/test-live-mcp.mjs"
  },
  "keywords": [
    "mcp",
    "olx",
    "scraper",
    "claude",
    "model-context-protocol",
    "web-scraping",
    "marketplace",
    "europe",
    "portugal",
    "poland",
    "india"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Harsh-2002",
  "license": "MIT",
  "description": "MCP server with OLX listing adapters for nine country sites and live location lookup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harsh-2002/OLX-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Harsh-2002/OLX-MCP/issues"
  },
  "homepage": "https://github.com/Harsh-2002/OLX-MCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "playwright": "^1.63.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
